# Copia este archivo a .env y completa los valores. .env NUNCA se versiona.
# En GitHub Actions estas variables se definen como Secrets del repositorio.

# --- Fuentes de datos ---
API_FOOTBALL_KEY=
# Proveedor de tenis (pendiente de confirmar). Ver docs/data-sources.md
TENNIS_API_KEY=
TENNIS_API_BASE_URL=

# --- Claude (narrativa del informe) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://sports:sports@localhost:5432/sports

# --- Ejecución ---
APP_TIMEZONE=America/Bogota
LOG_LEVEL=INFO
# true = no llama APIs reales ni envía mensajes (usa datos simulados)
DRY_RUN=false
