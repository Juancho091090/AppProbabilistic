# Copia este archivo a .env y completa los valores. .env NUNCA se versiona.
# En GitHub Actions estas variables se definen como Secrets del repositorio.

# --- Fuentes de datos ---
# API-Football (api-sports.io, plan Pro): clave del dashboard de api-football.com
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=7000
# Tennis API – ATP WTA ITF (RapidAPI, plan Basic): tu X-RapidAPI-Key
TENNIS_API_KEY=
TENNIS_API_DAILY_LIMIT=45

# --- Claude (narrativa del informe; opcional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email SMTP (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
# Varios destinatarios separados por coma
EMAIL_TO=

# --- Base de datos ---
# Local (docker compose): postgresql+psycopg://sports:sports@localhost:5432/sports
# Producción (Neon/Supabase): pega la connection string tal cual (postgresql://...?sslmode=require)
DATABASE_URL=postgresql+psycopg://sports:sports@localhost:5432/sports

# --- Ejecución ---
APP_TIMEZONE=America/Bogota
LOG_LEVEL=INFO
# true = genera el informe pero no envía Telegram/Email
DRY_RUN=false

# --- Presupuestos de ingesta por ejecución (opcionales) ---
FOOTBALL_HISTORY_SEASONS=3
FOOTBALL_STATS_PER_RUN=2500
# Benchmark de mercado (solo evaluación). API-Football conserva los precios ~7 días.
FOOTBALL_ODDS_CALLS_PER_RUN=300
MARKET_ODDS_BACKFILL_DAYS=6
TENNIS_HISTORY_DAYS=730
TENNIS_BACKFILL_CALLS_PER_RUN=30
